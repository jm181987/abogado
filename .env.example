# Server-only PostgreSQL connection. Never expose this with a VITE_ prefix.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional server tuning
DB_POOL_MAX=10
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=knj_admin_session
MAX_UPLOAD_BYTES=15728640

# Optional: override the SHA-256 allowlist used for the one-time admin bootstrap.
# BOOTSTRAP_ADMIN_EMAIL_SHA256=

# Leave at 0 for the first boot so the existing site content and images are copied.
# Set to 1 only after migration_state confirms the legacy import completed.
SKIP_LEGACY_MIGRATION=0
